# Docker Environment Variables Example
# Copy this file to .env and fill in your actual values

# Binance API Credentials (Optional - can also use config.yaml)
# BINANCE_API_KEY=your_api_key_here
# BINANCE_API_SECRET=your_api_secret_here

# Logging Level
RUST_LOG=info

# Python Settings
PYTHONUNBUFFERED=1

# Bot Configuration (Optional overrides)
# BOT_MODE=backtest  # backtest, testnet, or live
# STRATEGY=triangular  # triangular, funding_rate, or hybrid
